#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)

# Render test for glossy screen-space reflections: three coloured blocks on a
# grey metal floor of roughness 0.3, lit only by an even sky, so nothing in
# the path tracer's reference is noisy caustics. The blocks' reflections
# should blur as much as the path tracer's, more with distance from each
# block's foot.
def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Floor"
        {
            token outputs:surface.connect = </World/Looks/Floor/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.6, 0.6)
                float inputs:metallic = 1
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
        def Material "Block0"
        {
            token outputs:surface.connect = </World/Looks/Block0/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.15, 0.1)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
        def Material "Block1"
        {
            token outputs:surface.connect = </World/Looks/Block1/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.6, 0.2)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
        def Material "Block2"
        {
            token outputs:surface.connect = </World/Looks/Block2/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.35, 0.8)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
    }

    def Camera "main_cam"
    {
        float focalLength = 28
        float horizontalAperture = 36
        float verticalAperture = 20.25
        double3 xformOp:translate = (0, 1.4, 3)
        float3 xformOp:rotateXYZ = (-12, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def DomeLight "sky"
    {
        color3f inputs:color = (0.8, 0.85, 1)
        float inputs:intensity = 0.6
    }

    def Cube "floor" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </World/Looks/Floor>
        float3 xformOp:scale = (20, 0.1, 20)
        double3 xformOp:translate = (0, -0.05, -4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "block0" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </World/Looks/Block0>
        float3 xformOp:scale = (1, 2, 1)
        double3 xformOp:translate = (-2.2, 1, -5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "block1" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </World/Looks/Block1>
        float3 xformOp:scale = (1, 2, 1)
        double3 xformOp:translate = (0.0, 1, -5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "block2" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </World/Looks/Block2>
        float3 xformOp:scale = (1, 2, 1)
        double3 xformOp:translate = (2.2, 1, -5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
