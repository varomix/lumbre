#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)

# Render test for glossy environment reflections: metal (top) and red plastic
# (bottom) spheres at roughness 0, 0.2, 0.4, 0.6, 0.8 and 1, left to right,
# lit only by an HDRI. The realtime prefiltered environment should blur each
# reflection as much as the path tracer's GGX does at the same roughness.
def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Metal0"
        {
            token outputs:surface.connect = </World/Looks/Metal0/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.93, 0.88)
                float inputs:metallic = 1
                float inputs:roughness = 0.0
                token outputs:surface
            }
        }
        def Material "Metal1"
        {
            token outputs:surface.connect = </World/Looks/Metal1/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.93, 0.88)
                float inputs:metallic = 1
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }
        def Material "Metal2"
        {
            token outputs:surface.connect = </World/Looks/Metal2/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.93, 0.88)
                float inputs:metallic = 1
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }
        def Material "Metal3"
        {
            token outputs:surface.connect = </World/Looks/Metal3/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.93, 0.88)
                float inputs:metallic = 1
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
        def Material "Metal4"
        {
            token outputs:surface.connect = </World/Looks/Metal4/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.93, 0.88)
                float inputs:metallic = 1
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
        def Material "Metal5"
        {
            token outputs:surface.connect = </World/Looks/Metal5/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.93, 0.88)
                float inputs:metallic = 1
                float inputs:roughness = 1.0
                token outputs:surface
            }
        }
        def Material "Plastic0"
        {
            token outputs:surface.connect = </World/Looks/Plastic0/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.08, 0.06)
                float inputs:metallic = 0
                float inputs:roughness = 0.0
                token outputs:surface
            }
        }
        def Material "Plastic1"
        {
            token outputs:surface.connect = </World/Looks/Plastic1/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.08, 0.06)
                float inputs:metallic = 0
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }
        def Material "Plastic2"
        {
            token outputs:surface.connect = </World/Looks/Plastic2/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.08, 0.06)
                float inputs:metallic = 0
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }
        def Material "Plastic3"
        {
            token outputs:surface.connect = </World/Looks/Plastic3/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.08, 0.06)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
        def Material "Plastic4"
        {
            token outputs:surface.connect = </World/Looks/Plastic4/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.08, 0.06)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
        def Material "Plastic5"
        {
            token outputs:surface.connect = </World/Looks/Plastic5/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.08, 0.06)
                float inputs:metallic = 0
                float inputs:roughness = 1.0
                token outputs:surface
            }
        }
    }

    def Camera "main_cam"
    {
        float focalLength = 35
        float horizontalAperture = 36
        float verticalAperture = 20.25
        double3 xformOp:translate = (0, 0, 13.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def DomeLight "env"
    {
        asset inputs:texture:file = @../../lib/darwin/usd/usd/hdx/resources/textures/StinsonBeach.hdr@
        float inputs:intensity = 1
    }

    def Sphere "metal0" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 1
        rel material:binding = </World/Looks/Metal0>
        double3 xformOp:translate = (-5.5, 1.15, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "metal1" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 1
        rel material:binding = </World/Looks/Metal1>
        double3 xformOp:translate = (-3.3, 1.15, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "metal2" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 1
        rel material:binding = </World/Looks/Metal2>
        double3 xformOp:translate = (-1.1, 1.15, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "metal3" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 1
        rel material:binding = </World/Looks/Metal3>
        double3 xformOp:translate = (1.1, 1.15, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "metal4" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 1
        rel material:binding = </World/Looks/Metal4>
        double3 xformOp:translate = (3.3, 1.15, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "metal5" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 1
        rel material:binding = </World/Looks/Metal5>
        double3 xformOp:translate = (5.5, 1.15, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "plastic0" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 1
        rel material:binding = </World/Looks/Plastic0>
        double3 xformOp:translate = (-5.5, -1.15, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "plastic1" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 1
        rel material:binding = </World/Looks/Plastic1>
        double3 xformOp:translate = (-3.3, -1.15, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "plastic2" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 1
        rel material:binding = </World/Looks/Plastic2>
        double3 xformOp:translate = (-1.1, -1.15, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "plastic3" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 1
        rel material:binding = </World/Looks/Plastic3>
        double3 xformOp:translate = (1.1, -1.15, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "plastic4" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 1
        rel material:binding = </World/Looks/Plastic4>
        double3 xformOp:translate = (3.3, -1.15, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "plastic5" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 1
        rel material:binding = </World/Looks/Plastic5>
        double3 xformOp:translate = (5.5, -1.15, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
