#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)

# Render test for area lights: a rect, a disk, a sphere and a cylinder light
# close above a glossy floor. Their reflections should take the lights' own
# shapes, stretched along the view, and the matte box and ball should be lit
# softly by sources near enough that their size matters.
def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Glossy"
        {
            token outputs:surface.connect = </World/Looks/Glossy/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.12, 0.13)
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "Matte"
        {
            token outputs:surface.connect = </World/Looks/Matte/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.7, 0.7)
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
    }

    def Camera "main_cam"
    {
        float focalLength = 28
        float horizontalAperture = 36
        float verticalAperture = 20.25
        double3 xformOp:translate = (0, 2.2, 8)
        float3 xformOp:rotateXYZ = (-12, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Cube "floor" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </World/Looks/Glossy>
        float3 xformOp:scale = (20, 0.1, 20)
        double3 xformOp:translate = (0, -0.05, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "box" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 0.8
        rel material:binding = </World/Looks/Matte>
        double3 xformOp:translate = (-0.9, 0.4, 0.6)
        float3 xformOp:rotateXYZ = (0, 30, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Sphere "ball" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.45
        rel material:binding = </World/Looks/Matte>
        double3 xformOp:translate = (1.1, 0.45, 0.9)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # Standing panel, facing the camera.
    def RectLight "panel"
    {
        float inputs:width = 1.6
        float inputs:height = 1
        float inputs:intensity = 6
        color3f inputs:color = (1, 0.92, 0.8)
        double3 xformOp:translate = (-2.6, 1.3, -1.5)
        float3 xformOp:rotateXYZ = (0, 200, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    # Disk tilted down toward the floor.
    def DiskLight "disk"
    {
        float inputs:radius = 0.45
        float inputs:intensity = 8
        color3f inputs:color = (0.75, 0.85, 1)
        double3 xformOp:translate = (0.2, 1.6, -1.8)
        float3 xformOp:rotateXYZ = (-60, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def SphereLight "orb"
    {
        float inputs:radius = 0.22
        float inputs:intensity = 25
        color3f inputs:color = (1, 0.7, 0.45)
        double3 xformOp:translate = (2.4, 0.9, -0.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # A tube lying along x, low over the floor at the front.
    def CylinderLight "tube"
    {
        float inputs:length = 2.2
        float inputs:radius = 0.04
        float inputs:intensity = 30
        color3f inputs:color = (0.85, 1, 0.85)
        double3 xformOp:translate = (0.3, 0.5, 2.4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
