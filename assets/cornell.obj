# Simple Cornell box test scene for Lumbre

mtllib cornell.mtl

# Floor
v -1.0 0.0 -1.0
v  1.0 0.0 -1.0
v  1.0 0.0  1.0
v -1.0 0.0  1.0

# Ceiling
v -1.0 2.0 -1.0
v  1.0 2.0 -1.0
v  1.0 2.0  1.0
v -1.0 2.0  1.0

# Back wall
v -1.0 0.0  1.0
v  1.0 0.0  1.0
v  1.0 2.0  1.0
v -1.0 2.0  1.0

# Left wall (red)
v -1.0 0.0 -1.0
v -1.0 0.0  1.0
v -1.0 2.0  1.0
v -1.0 2.0 -1.0

# Right wall (green)
v  1.0 0.0 -1.0
v  1.0 0.0  1.0
v  1.0 2.0  1.0
v  1.0 2.0 -1.0

# Light (ceiling square)
v -0.3 1.99 -0.3
v  0.3 1.99 -0.3
v  0.3 1.99  0.3
v -0.3 1.99  0.3

# Small box in room
v -0.6 0.0 -0.6
v -0.2 0.0 -0.6
v -0.2 0.0 -0.2
v -0.6 0.0 -0.2
v -0.6 0.8 -0.6
v -0.2 0.8 -0.6
v -0.2 0.8 -0.2
v -0.6 0.8 -0.2

# Tall box in room
v  0.2 0.0 0.2
v  0.6 0.0 0.2
v  0.6 0.0 0.6
v  0.2 0.0 0.6
v  0.2 1.4 0.2
v  0.6 1.4 0.2
v  0.6 1.4 0.6
v  0.2 1.4 0.6

# Normals
vn 0.0 1.0 0.0
vn 0.0 -1.0 0.0
vn 0.0 0.0 -1.0
vn -1.0 0.0 0.0
vn 1.0 0.0 0.0
vn 0.0 0.0 1.0

usemtl floor
f 1//1 2//1 3//1
f 1//1 3//1 4//1

usemtl ceiling
f 5//2 8//2 7//2
f 5//2 7//2 6//2

usemtl back_wall
f 9//3 12//3 11//3
f 9//3 11//3 10//3

usemtl left_wall
f 13//4 16//4 15//4
f 13//4 15//4 14//4

usemtl right_wall
f 17//6 18//6 19//6
f 17//6 19//6 20//6

usemtl light
f 21//2 24//2 23//2
f 21//2 23//2 22//2

usemtl small_box
f 25//1 28//1 27//1
f 25//1 27//1 26//1
f 29//3 30//3 31//3
f 29//3 31//3 32//3
f 25//4 26//4 30//3
f 25//4 30//3 29//3
f 27//5 31//3 30//3
f 27//5 30//3 26//4
f 28//1 32//3 31//3
f 28//1 31//3 27//1
f 25//1 29//3 32//3
f 25//1 32//3 28//1

usemtl tall_box
f 33//1 36//1 35//1
f 33//1 35//1 34//1
f 37//3 38//3 39//3
f 37//3 39//3 40//3
f 33//4 34//4 38//3
f 33//4 38//3 37//3
f 35//5 39//3 38//3
f 35//5 38//3 34//4
f 36//1 40//3 39//3
f 36//1 39//3 35//1
f 33//1 37//3 40//3
f 33//1 40//3 36//1
