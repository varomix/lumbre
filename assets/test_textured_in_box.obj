# Open box with a textured plane inside, for testing the texture pipeline.
# The box has 5 walls (no front face on +Z). A textured plane sits inside
# the box, facing the +Z direction. The make_scene heuristic places the
# camera in the +Z opening, so the textured plane is in plain view.

v -1.0 -1.0 -1.0
v  1.0 -1.0 -1.0
v  1.0  1.0 -1.0
v -1.0  1.0 -1.0
v -1.0 -1.0  1.0
v  1.0 -1.0  1.0
v  1.0  1.0  1.0
v -1.0  1.0  1.0

# Textured plane vertices (smaller, inside the box, facing +Z)
# Placed slightly in front of the back wall (-Z) so it's visible
# from the camera at +Z.
v -0.6 -0.6 -0.5
v  0.6 -0.6 -0.5
v  0.6  0.6 -0.5
v -0.6  0.6 -0.5

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn  0.0 -1.0  0.0
vn  0.0  1.0  0.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0

mtllib test_textured_in_box.mtl

# Back face (-Z) — plain white
usemtl white
f 1//1 4//1 3//1
f 1//1 3//1 2//1

# Bottom (-Y) — plain gray
usemtl gray
f 1//3 2//3 6//3
f 1//3 6//3 5//3

# Top (+Y) — plain light gray
usemtl light_gray
f 4//4 8//4 7//4
f 4//4 7//4 3//4

# Left (-X) — plain red
usemtl red
f 1//5 5//5 8//5
f 1//5 8//5 4//5

# Right (+X) — plain green
usemtl green
f 2//6 3//6 7//6
f 2//6 7//6 6//6

# Textured plane (facing +Z) — uses UVs
usemtl tex_face
f 9/1/2 10/2/2 11/3/2
f 9/1/2 11/3/2 12/4/2
