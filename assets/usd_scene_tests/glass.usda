#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)

# Transparency: a glass slab and a glass sphere in front of opaque, distinctly
# coloured geometry, so refraction and tint are visible as something other than
# grey. The opaque prims behind are what a transmission pass has to show
# through; the sun gives the scene a shadow to check glass does not vanish from
# the shadow map.

def Xform "World"
{
    def Cube "Floor"
    {
        double size = 1
        float3 xformOp:scale = (6, 0.1, 6)
        double3 xformOp:translate = (0, -0.05, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Scope "Looks"
    {
        def Material "Glass"
        {
            token outputs:surface.connect = </World/Looks/Glass/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.95, 1.0)
                float inputs:opacity = 0.1
                float inputs:ior = 1.5
                float inputs:roughness = 0.05
                float inputs:metallic = 0
                token outputs:surface
            }
        }

        def Material "Red"
        {
            token outputs:surface.connect = </World/Looks/Red/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.1, 0.1)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Green"
        {
            token outputs:surface.connect = </World/Looks/Green/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.7, 0.2)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Cube "RedPost" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </World/Looks/Red>
        custom string semantic:class = "post"
        float3 xformOp:scale = (0.5, 2.4, 0.5)
        double3 xformOp:translate = (-1.1, 1.2, -1.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Sphere "GreenBall" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.7
        rel material:binding = </World/Looks/Green>
        custom string semantic:class = "ball"
        double3 xformOp:translate = (1.2, 0.7, -1.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "GlassSlab" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </World/Looks/Glass>
        custom string semantic:class = "glass"
        float3 xformOp:scale = (3.2, 2.0, 0.12)
        double3 xformOp:translate = (0, 1.0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Sphere "GlassBall" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.6
        rel material:binding = </World/Looks/Glass>
        custom string semantic:class = "glass"
        double3 xformOp:translate = (0, 0.6, 1.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Camera "Cam"
    {
        float focalLength = 28
        double3 xformOp:translate = (0, 2.6, 6.5)
        float3 xformOp:rotateXYZ = (-14, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def DistantLight "Sun"
    {
        float inputs:intensity = 3
        float3 xformOp:rotateXYZ = (-48, 28, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
}
