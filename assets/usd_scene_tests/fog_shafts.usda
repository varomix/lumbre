#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)

# Fog and light shafts: a row of tall slats between a low sun and the camera,
# so with --fog 1 the gaps between them read as bright shafts crossing darker
# air, and the far posts fade with distance where the near one does not. The
# sun comes from behind and to the left of the slats, toward the camera.
# Without fog this is an ordinary shadow scene.

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Stone"
        {
            token outputs:surface.connect = </World/Looks/Stone/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.35, 0.33, 0.3)
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "Red"
        {
            token outputs:surface.connect = </World/Looks/Red/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.1, 0.1)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Cube "Floor" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </World/Looks/Stone>
        float3 xformOp:scale = (40, 0.1, 40)
        double3 xformOp:translate = (0, -0.05, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "Slats"
    {
        def Cube "S0" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 1
            rel material:binding = </World/Looks/Stone>
            float3 xformOp:scale = (1.2, 7, 0.3)
            double3 xformOp:translate = (-5, 3.5, -4)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "S1" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 1
            rel material:binding = </World/Looks/Stone>
            float3 xformOp:scale = (1.2, 7, 0.3)
            double3 xformOp:translate = (-2.5, 3.5, -4)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "S2" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 1
            rel material:binding = </World/Looks/Stone>
            float3 xformOp:scale = (1.2, 7, 0.3)
            double3 xformOp:translate = (0, 3.5, -4)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "S3" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 1
            rel material:binding = </World/Looks/Stone>
            float3 xformOp:scale = (1.2, 7, 0.3)
            double3 xformOp:translate = (2.5, 3.5, -4)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "S4" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 1
            rel material:binding = </World/Looks/Stone>
            float3 xformOp:scale = (1.2, 7, 0.3)
            double3 xformOp:translate = (5, 3.5, -4)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Cube "NearPost" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1
        rel material:binding = </World/Looks/Red>
        float3 xformOp:scale = (0.5, 2, 0.5)
        double3 xformOp:translate = (3, 1, 5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "FarPost" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1
        rel material:binding = </World/Looks/Red>
        float3 xformOp:scale = (0.5, 2, 0.5)
        double3 xformOp:translate = (-6, 1, -14)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Camera "Cam"
    {
        float focalLength = 24
        double3 xformOp:translate = (1.5, 2.2, 13)
        float3 xformOp:rotateXYZ = (-4, 4, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def DistantLight "Sun"
    {
        float inputs:intensity = 4
        float3 xformOp:rotateXYZ = (-25, 200, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
}
