#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)

def Xform "World"
{
    def Camera "main_cam"
    {
        float focalLength = 35
        float horizontalAperture = 36
        float verticalAperture = 24
        double3 xformOp:translate = (0, 2, 8)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def DistantLight "sun"
    {
        # UsdLux's schema default (50000) is calibrated for physically-based
        # renderers; Lumbre's radiance mapping is a direct pass-through (see
        # usd_light_import.odin), so this is overridden to a value that
        # renders reasonably until that mapping is verified against a
        # reference renderer (plans/USD_SCENE_FORMAT.md verification step 4).
        float inputs:intensity = 3
        float3 xformOp:rotateXYZ = (-45, 30, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Cube "box"
    {
        double size = 2
    }
}
