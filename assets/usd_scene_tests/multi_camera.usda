#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)

def Xform "World"
{
    def Camera "wide_shot"
    {
        float focalLength = 24
        float horizontalAperture = 36
        float verticalAperture = 24
        double3 xformOp:translate = (0, 3, 12)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Camera "close_up"
    {
        float focalLength = 85
        float horizontalAperture = 36
        float verticalAperture = 24
        double3 xformOp:translate = (0, 1, 3)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "box"
    {
        double size = 2
    }
}
