#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)

# Screen-space reflections: a polished floor under distinctly coloured
# geometry, so each reflection is identifiable as its object rather than as
# tinted sky. The chrome ball reflects things off screen and behind the camera,
# which a screen-space trace cannot find -- it is there to show the fallback to
# the environment, not a reflection. The rough pad lies in the same floor plane
# and should show no reflection at all.

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Polished"
        {
            token outputs:surface.connect = </World/Looks/Polished/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.08, 0.09)
                float inputs:roughness = 0.05
                float inputs:metallic = 0
                token outputs:surface
            }
        }

        def Material "Rough"
        {
            token outputs:surface.connect = </World/Looks/Rough/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.08, 0.09)
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "Chrome"
        {
            token outputs:surface.connect = </World/Looks/Chrome/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.9, 0.9)
                float inputs:roughness = 0.05
                float inputs:metallic = 1
                token outputs:surface
            }
        }

        def Material "Red"
        {
            token outputs:surface.connect = </World/Looks/Red/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.1, 0.1)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Green"
        {
            token outputs:surface.connect = </World/Looks/Green/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.7, 0.2)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Blue"
        {
            token outputs:surface.connect = </World/Looks/Blue/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.3, 0.85)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Cube "Floor" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </World/Looks/Polished>
        float3 xformOp:scale = (10, 0.1, 10)
        double3 xformOp:translate = (0, -0.05, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "RoughPad" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </World/Looks/Rough>
        float3 xformOp:scale = (2.2, 0.02, 1.6)
        double3 xformOp:translate = (2.6, 0.01, 0.4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "RedPost" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </World/Looks/Red>
        float3 xformOp:scale = (0.5, 2.4, 0.5)
        double3 xformOp:translate = (-1.8, 1.2, -1.2)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Sphere "GreenBall" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.7
        rel material:binding = </World/Looks/Green>
        double3 xformOp:translate = (0.2, 0.7, -1.4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "BlueBox" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </World/Looks/Blue>
        float3 xformOp:scale = (1.0, 1.0, 1.0)
        double3 xformOp:translate = (2.6, 0.52, -0.2)
        float3 xformOp:rotateXYZ = (0, 30, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Sphere "ChromeBall" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.5
        rel material:binding = </World/Looks/Chrome>
        double3 xformOp:translate = (-0.6, 0.5, 1.2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Camera "Cam"
    {
        float focalLength = 28
        double3 xformOp:translate = (0, 2.0, 6.5)
        float3 xformOp:rotateXYZ = (-14, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def DistantLight "Sun"
    {
        float inputs:intensity = 3
        float3 xformOp:rotateXYZ = (-48, 28, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
}
