#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 24
    timeCodesPerSecond = 24
    framesPerSecond = 24
)

# Motion-vector test scene. The first animated scene in the repo:
#   mover    -- translate authored only as time samples (no default value),
#               +X by 0.25 units per frame, so a frame-to-frame step is exact.
#   spinner  -- rotateY sampled at two frames; USD interpolates between them
#               (15 degrees per frame).
#   parent/child -- the parent is animated and the child is static, so the
#               child moves only through its parent's world transform.
#   static_box, floor -- no time samples: velocity must be exactly zero.
#   scatter  -- a PointInstancer whose positions are sampled only, +0.05 Y/frame.
#   camera   -- static, so object motion is the only motion in the frame.
# The importer currently reads UsdTimeCode::Default(), which ignores time
# samples, so before time-aware import every animated op resolves to nothing.

def Xform "World"
{
    def Camera "main_cam"
    {
        float focalLength = 35
        float horizontalAperture = 36
        float verticalAperture = 24
        double3 xformOp:translate = (0, 2.5, 10)
        float3 xformOp:rotateXYZ = (-10, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def DistantLight "sun"
    {
        float inputs:intensity = 3
        float3 xformOp:rotateXYZ = (-45, 30, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Cube "floor"
    {
        double size = 1
        double3 xformOp:translate = (0, -0.05, 0)
        float3 xformOp:scale = (14, 0.1, 8)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "mover"
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.8, 0.2, 0.15)]
        double3 xformOp:translate.timeSamples = {
            1: (-3, 0.5, 1.5),
            24: (2.75, 0.5, 1.5),
        }
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "spinner"
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.2, 0.5, 0.85)]
        double3 xformOp:translate = (2, 0.5, -1.5)
        float xformOp:rotateY.timeSamples = {
            1: 0,
            24: 345,
        }
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY"]
    }

    def Xform "parent"
    {
        double3 xformOp:translate.timeSamples = {
            1: (-2, 0, -1.5),
            24: (-2, 2.3, -1.5),
        }
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Sphere "child"
        {
            double radius = 0.5
            color3f[] primvars:displayColor = [(0.3, 0.75, 0.3)]
            double3 xformOp:translate = (0, 0.5, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    # Two instances whose positions are time samples only: each rises 0.05
    # per frame. Default-time import falls back to the first sample.
    def PointInstancer "scatter"
    {
        rel prototypes = [</World/scatter/protos/pebble>]
        int[] protoIndices = [0, 0]
        point3f[] positions.timeSamples = {
            1: [(3.5, 0.2, 2), (4.5, 0.2, 2)],
            24: [(3.5, 1.35, 2), (4.5, 1.35, 2)],
        }

        def Scope "protos"
        {
            def Cube "pebble"
            {
                double size = 0.4
            }
        }
    }

    def Cube "static_box"
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.7, 0.7, 0.7)]
        double3 xformOp:translate = (0, 0.5, -2.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
