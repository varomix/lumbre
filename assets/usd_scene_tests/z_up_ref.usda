#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
)

# Same scene as y_up_ref.usda but authored Z-up: the marker sits above the
# base along +Z here (Y-up (0,1.5,0) maps to Z-up (0,0,1.5)). After the
# loader's Z-up->Y-up correction, this must render identically to y_up_ref.
def Xform "World"
{
    def Cube "base"
    {
        double size = 2
    }

    def Cube "marker"
    {
        double size = 0.6
        double3 xformOp:translate = (0, 0, 1.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
